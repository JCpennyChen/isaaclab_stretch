{
  "algo_name": "diffusion_policy",
  "experiment": {
    "name": "stretch_diffusion_policy",
    "validate": true,
    "logging": {
      "terminal_output_to_txt": true,
      "log_tb": true
    },
    "save": {
      "enabled": true,
      "every_n_epochs": 50,
      "on_best_validation": true,
      "on_best_rollout_success_rate": false
    },
    "rollout": {
      "enabled": false
    },
    "render": false
  },
  "train": {
    "data": "/mnt/shared_ssd/JohnChen/stretch/datasets/stretch_cabinet_demo.hdf5",
    "output_dir": "../diffusion_trained_models",
    "num_data_workers": 4,
    "hdf5_cache_mode": "all",
    "hdf5_use_swmr": true,
    "hdf5_normalize_obs": true,
    "hdf5_filter_key": "train",
    "hdf5_validation_filter_key": "valid",
    "seq_length": 16,
    "dataset_keys": ["actions", "rewards", "dones"],
    "action_keys": ["actions"],
    "cuda": true,
    "batch_size": 128,
    "num_epochs": 200,
    "seed": 1
  },
  "algo": {
    "optim_params": {
      "policy": {
        "optimizer_type": "adamw",
        "learning_rate": {
          "initial": 1e-4,
          "decay_factor": 0.1,
          "epoch_schedule": []
        },
        "regularization": {
          "L2": 1e-6
        }
      }
    },
    "ddpm": {
      "num_inference_timesteps": 100,
      "beta_schedule": "squaredcos_cap_v2",
      "prediction_horizon": 16,
      "observation_horizon": 2,
      "action_horizon": 8,
      "clip_sample": true
    },
    "unet": {
      "diffusion_step_embed_dim": 256,
      "down_dims": [256, 512, 1024],
      "kernel_size": 5,
      "n_groups": 8
    },
    "ema": {
      "enabled": true,
      "power": 0.75
    }
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": ["policy"],
        "rgb": [],
        "depth": [],
        "scan": []
      },
      "goal": {
        "low_dim": [],
        "rgb": [],
        "depth": [],
        "scan": []
      }
    },
    "encoder": {
      "low_dim": {
        "core_class": null,
        "core_kwargs": {},
        "flatten": true,
        "n_obs_steps": 2
      }
    }
  }
}
