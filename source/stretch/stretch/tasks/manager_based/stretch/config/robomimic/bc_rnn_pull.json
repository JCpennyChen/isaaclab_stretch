{
  "algo_name": "bc",
  "experiment": {
    "name": "bc_rnn_pull_phase",
    "validate": true,
    "epoch_every_n_steps": 100,
    "validation_epoch_every_n_steps": 1,
    "logging": {
      "terminal_output_to_txt": true,
      "log_tb": true
    },
    "save": {
      "enabled": true,
      "every_n_epochs": 50,
      "on_best_validation": true,
      "on_best_rollout_success_rate": false
    },
    "rollout": {
      "enabled": false
    },
    "render": false
  },
  "train": {
    "data": "/mnt/shared_ssd/JohnChen/stretch/datasets/stretch_cabinet_data_pull.hdf5",
    "output_dir": "../bc_rnn_trained_models",
    "num_data_workers": 8,
    "hdf5_cache_mode": "all",
    "hdf5_use_swmr": true,
    "hdf5_normalize_obs": true,
    "hdf5_filter_key": "train",
    "hdf5_validation_filter_key": "valid",
    "seq_length": 16,
    "dataset_keys": ["actions"],
    "action_keys": ["actions"],
    "action_config": {
      "actions": {
        "normalization": "min_max"
      }
    },
    "cuda": true,
    "batch_size": 64,
    "num_epochs": 200,
    "seed": 1
  },
  "algo": {
    "optim_params": {
      "policy": {
        "optimizer_type": "adam",
        "learning_rate": {
          "initial": 1e-4,
          "decay_factor": 0.1,
          "epoch_schedule": [120, 160]
        },
        "regularization": {
          "L2": 1e-3
        }
      }
    },
    "loss": {
      "l2_weight": 1.0,
      "l1_weight": 0.0,
      "cos_weight": 0.1
    },
    "actor_layer_dims": [128],
    "rnn": {
      "enabled": true,
      "horizon": 15,
      "hidden_dim": 128,
      "rnn_type": "LSTM",
      "num_layers": 1,
      "open_loop": false,
      "kwargs": {
        "bidirectional": false
      }
    }
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": ["policy"],
        "rgb": [],
        "depth": [],
        "scan": []
      },
      "goal": {
        "low_dim": [],
        "rgb": [],
        "depth": [],
        "scan": []
      }
    },
    "encoder": {
      "low_dim": {
        "core_class": null,
        "core_kwargs": {}
      }
    }
  }
}
