{
  "algo_name": "bc",
  "experiment": {
    "name": "stretch_bc_rnn",
    "validate": true,
    "logging": {
      "terminal_output_to_txt": true,
      "log_tb": true
    },
    "save": {
      "enabled": true,
      "on_best_validation": true,
      "on_best_rollout_success_rate": false
    },
    "rollout": {
      "enabled": true
    },
    "render": false
  },
  "train": {
    "data": "/mnt/shared_ssd/JohnChen/stretch/datasets/stretch_cabinet_demo.hdf5",
    "output_dir": "../bc_rnn_trained_models",
    "num_data_workers": 8,
    "hdf5_cache_mode": "all",
    "hdf5_use_swmr": true,
    "hdf5_normalize_obs": true,
    "hdf5_filter_key": "train",
    "hdf5_validation_filter_key": "valid",
    "seq_length": 30,
    "dataset_keys": ["actions"],
    "action_keys": ["actions"],
    "cuda": true,
    "batch_size": 1024,
    "num_epochs": 5000,
    "seed": 1
  },
  "algo": {
    "optim_params": {
      "policy": {
        "optimizer_type": "adam",
        "learning_rate": {
          "initial": 0.0001,
          "decay_factor": 0.1,
          "epoch_schedule": [3000, 4000]
        },
        "regularization": {
          "L2": 0.0
        }
      }
    },
    "loss": {
      "l2_weight": 1.0,
      "l1_weight": 0.0,
      "cos_weight": 0.0
    },
    "actor_layer_dims": [256, 256],
    "rnn": {
      "enabled": true,
      "horizon": 20,
      "hidden_dim": 256,
      "rnn_type": "LSTM",
      "num_layers": 2,
      "open_loop": false,
      "kwargs": {
        "bidirectional": false
      }
    }
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": ["policy"],
        "rgb": [],
        "depth": [],
        "scan": []
      },
      "goal": {
        "low_dim": [],
        "rgb": [],
        "depth": [],
        "scan": []
      }
    },
    "encoder": {
      "low_dim": {
        "core_class": null,
        "core_kwargs": {}
      }
    }
  }
}
