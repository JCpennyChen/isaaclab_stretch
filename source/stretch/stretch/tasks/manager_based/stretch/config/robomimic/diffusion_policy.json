{
  "algo_name": "diffusion_policy",
  "experiment": {
    "name": "diffusion_policy_full",
    "validate": true,
    "logging": {
      "terminal_output_to_txt": true,
      "log_tb": true
    },
    "save": {
      "enabled": true,
      "every_n_epochs": 50,
      "on_best_validation": true,
      "on_best_rollout_success_rate": false
    },
    "rollout": {
      "enabled": false
    },
    "render": false
  },
  "train": {
    "data": "/mnt/shared_ssd/JohnChen/stretch/datasets/diff_pol_model.hdf5",
    "output_dir": "../diffusion_policy_trained_models",
    "num_data_workers": 8,
    "hdf5_cache_mode": "all",
    "hdf5_use_swmr": true,
    "hdf5_normalize_obs": true,
    "hdf5_filter_key": "train",
    "hdf5_validation_filter_key": "valid",
    "seq_length": 8,
    "dataset_keys": ["actions"],
    "action_keys": ["actions"],
    "action_config": {
      "actions": {
        "normalization": "gaussian"
      }
    },
    "cuda": true,
    "batch_size": 128,
    "num_epochs": 500,
    "seed": 1
  },
  "algo": {
    "optim_params": {
      "policy": {
        "optimizer_type": "adam",
        "learning_rate": {
          "initial": 1e-4,
          "decay_factor": 0.1,
          "epoch_schedule": [],
          "scheduler_type": "multistep"
        },
        "regularization": {
          "L2": 0.0
        }
      }
    },
    "horizon": {
      "observation_horizon": 1,
      "action_horizon": 4,
      "prediction_horizon": 8
    },
    "unet": {
      "enabled": true,
      "diffusion_step_embed_dim": 256,
      "down_dims": [256, 512, 1024],
      "kernel_size": 5,
      "n_groups": 8
    },
    "ema": {
      "enabled": true,
      "power": 0.75
    },
    "ddpm": {
      "enabled": true,
      "num_train_timesteps": 100,
      "num_inference_timesteps": 10,
      "beta_schedule": "squaredcos_cap_v2",
      "clip_sample": true,
      "prediction_type": "epsilon"
    }
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": ["policy", "handle_target"],
        "rgb": [],
        "depth": [],
        "scan": []
      },
      "goal": {
        "low_dim": [],
        "rgb": [],
        "depth": [],
        "scan": []
      }
    },
    "encoder": {
      "low_dim": {
        "core_class": null,
        "core_kwargs": {}
      }
    }
  }
}
